{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true
  },
  "vueCompilerOptions": {
    "skipTemplateCodegen": true,
    "strictTemplates": false
  },
  "include": [
    "src/**/*.vue",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/views/*.vue",
    "src/components/business/CategorySidebar.vue"
  ]
}
