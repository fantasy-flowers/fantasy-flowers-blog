# ===================================
# 生产环境配置
# Production Environment Configuration
# ===================================
# ⚠️ 警告: 部署前必须修改以下配置
# ⚠️ Warning: Must modify before deployment

# API配置
# API Configuration
# ⚠️ 请修改为实际的生产API地址
VITE_API_BASE_URL=http://localhost:3000/api/

# 功能开关
# Feature Flags
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SERVICE_WORKER=true

# 性能配置
# Performance Configuration
VITE_IMAGE_LAZY_LOAD=true
VITE_PRELOAD_IMAGES=true
VITE_ENABLE_COMPRESSION=true

# 图片缓存版本控制
# Image Cache Version Control
VITE_IMAGE_CACHE_VERSION=v1
VITE_ENABLE_IMAGE_CACHE_VERSION=true

# 构建优化
# Build Optimization
VITE_DROP_CONSOLE=true
VITE_SOURCE_MAP=false

# ===================================
# 部署前检查清单
# Pre-deployment Checklist
# ===================================
# [ ] 修改 VITE_API_BASE_URL 为实际API地址

