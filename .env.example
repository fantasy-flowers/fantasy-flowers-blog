# ===================================
# 环境变量配置模板
# Environment Variables Template
# ===================================
# 📝 说明: 复制此文件为 .env 并根据实际环境修改配置
# 📝 Note: Copy this file to .env and modify according to your environment

# ===================================
# 生产环境配置
# Production Environment Configuration
# ===================================
# ⚠️ 警告: 部署前必须修改以下配置
# ⚠️ Warning: Must modify before deployment

# API配置
# API Configuration
# ⚠️ 请修改为实际的生产API地址
VITE_API_BASE_URL=

# 静态资源基址（图片等静态文件服务器地址，统一无尾斜杠）
# Static Resource Base URL
VITE_STATIC_BASE_URL=

# 功能开关
# Feature Flags
# Service Worker：生产默认启用（false 关闭）；开发设为 true 可测试
VITE_ENABLE_SERVICE_WORKER=true

# 图片缓存版本控制
# Image Cache Version Control
VITE_IMAGE_CACHE_VERSION=v1
VITE_ENABLE_IMAGE_CACHE_VERSION=true

# 构建优化
# Build Optimization
# 生产构建移除 console（false 保留）
VITE_DROP_CONSOLE=true

# ===================================
# 部署前检查清单
# Pre-deployment Checklist
# ===================================
# [ ] 修改 VITE_API_BASE_URL 为实际API地址


# 应用配置
# Application Configuration
VITE_APP_TITLE=fantasy_flowers's Blog
VITE_APP_DESCRIPTION=基于 Vue 3 的高性能博客系统
VITE_APP_KEYWORDS=Vue3,Vite,博客,Blog,前端开发

# SEO配置
# SEO Configuration
VITE_SITE_URL=http://localhost:5173
VITE_AUTHOR_NAME=fantasy_flowers
VITE_AUTHOR_EMAIL=your-email@example.com

# 开发服务器配置
# Dev Server Configuration
VITE_DEV_PORT=5173
VITE_DEV_SERVER_OPEN=false
VITE_HMR_PORT=5173
VITE_HMR_HOST=localhost

# 第三方服务配置（可选）
# Third-party Services (Optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_DISQUS_SHORTNAME=
# VITE_CDN_URL=

