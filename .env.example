# ===================================
# 环境变量配置模板
# Environment Variables Template
# ===================================
# 📝 说明: 复制此文件为 .env 并根据实际环境修改配置
# 📝 Note: Copy this file to .env and modify according to your environment

# API配置
# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/

# 应用配置
# Application Configuration
VITE_APP_TITLE=fantasy_flowers's Blog
VITE_APP_DESCRIPTION=基于 Vue 3 的高性能博客系统
VITE_APP_KEYWORDS=Vue3,Vite,博客,Blog,前端开发

# SEO配置
# SEO Configuration
VITE_SITE_URL=http://localhost:5173
VITE_AUTHOR_NAME=fantasy_flowers
VITE_AUTHOR_EMAIL=your-email@example.com

# 功能开关
# Feature Flags
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SERVICE_WORKER=false

# 性能配置
# Performance Configuration
VITE_IMAGE_LAZY_LOAD=true
VITE_PRELOAD_IMAGES=true
VITE_ENABLE_COMPRESSION=true

# 开发服务器配置
# Dev Server Configuration
VITE_DEV_PORT=5173
VITE_DEV_SERVER_OPEN=false
VITE_HMR_PORT=5173
VITE_HMR_HOST=localhost

# 第三方服务配置（可选）
# Third-party Services (Optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_DISQUS_SHORTNAME=
# VITE_CDN_URL=

