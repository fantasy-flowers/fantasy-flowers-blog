# ===================================
# 开发环境配置
# Development Environment Configuration
# ===================================

# API配置
# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api/

# 应用配置
# Application Configuration
VITE_APP_TITLE=fantasy_flowers's Blog
VITE_APP_DESCRIPTION=基于 Vue 3 的高性能博客系统
VITE_APP_KEYWORDS=Vue3,Vite,博客,Blog,前端开发

# SEO配置
# SEO Configuration
VITE_SITE_URL=http://localhost:5173
VITE_AUTHOR_NAME=fantasy_flowers
VITE_AUTHOR_EMAIL=

# 功能开关
# Feature Flags
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SERVICE_WORKER=false

# 性能配置
# Performance Configuration
VITE_IMAGE_LAZY_LOAD=true
VITE_PRELOAD_IMAGES=true
VITE_ENABLE_COMPRESSION=true

# 图片缓存版本控制
# Image Cache Version Control
VITE_IMAGE_CACHE_VERSION=v1
VITE_ENABLE_IMAGE_CACHE_VERSION=true

# 开发服务器配置
# Dev Server Configuration
VITE_DEV_PORT=5173
VITE_DEV_SERVER_OPEN=false
VITE_HMR_PORT=5173
VITE_HMR_HOST=localhost
