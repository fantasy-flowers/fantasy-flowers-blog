# ===================================
# Vue.js / Vite 项目忽略文件
# Vue.js / Vite Project Gitignore
# ===================================


# 忽略 IDE 配置目录
.vscode/
.kiro/
.trae/

# 忽略 public 目录下的 images 构建文件夹
public/images/

# 依赖
# Dependencies
node_modules
.pnp
.pnp.js

# 构建输出
# Build Output
dist
dist-ssr
dist.zip
*.local
.review-dist
.build-check

# 日志文件
# Log Files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量
# Environment Variables
.env
.env.local
.env.*.local

# 编辑器和IDE
# Editor & IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 测试覆盖率
# Test Coverage
coverage
*.lcov
.nyc_output

# 缓存
# Cache
.cache
.vite
.eslintcache
.stylelintcache

# 系统文件
# System Files
Thumbs.db
Desktop.ini

# 临时文件
# Temporary Files
*.tmp
*.temp
.tmp/
.temp/

# 其他
docs/